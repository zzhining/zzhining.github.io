---
layout: none
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: "%Y-%m-%d" | jsonify }},"categories":{{ post.categories | join: ", " | jsonify }},"tags":{{ post.tags | join: ", " | jsonify }},"description":{{ post.description | default: "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
